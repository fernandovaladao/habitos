PORT=8080
APP_ENV=development
SESSION_COOKIE_SECURE=false

# Configuração pública do Firebase Web SDK
FIREBASE_PROJECT_ID=demo-habitos-local
GCLOUD_PROJECT=demo-habitos-local
FIREBASE_WEB_API_KEY=chave-publica-placeholder
FIREBASE_AUTH_DOMAIN=demo-habitos-local.firebaseapp.com
FIREBASE_APP_ID=1:000000000000:web:placeholder
FIREBASE_STORAGE_BUCKET=demo-habitos-local.appspot.com

# Emuladores opcionais (sem http://)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# OpenAI Responses API (segredo somente no backend)
OPENAI_API_KEY=chave-openai-placeholder
OPENAI_MODEL=gpt-5.6-luna
AI_REQUEST_TIMEOUT=10s

# Lembretes reais (valores fictícios no ambiente local)
APP_BASE_URL=http://localhost:8080
VAPID_PUBLIC_KEY=chave-publica-vapid-placeholder
VAPID_PRIVATE_KEY=chave-privada-vapid-placeholder
VAPID_SUBSCRIBER=mailto:contato@example.test
RESEND_API_KEY=chave-resend-placeholder
EMAIL_FROM=HABITOS <lembretes@example.test>
EMAIL_REQUEST_TIMEOUT=10s
# true somente na implantação privada invocada pelo Scheduler ou no desenvolvimento local
REMINDER_PROCESSOR_ENABLED=false
# O serviço web usa 30s; o processador privado usa 10m por padrão.
# HTTP_WRITE_TIMEOUT=30s

# Não defina GOOGLE_APPLICATION_CREDENTIALS ao usar os emuladores.
# Fora deles, qualquer arquivo administrativo deve permanecer fora do repositório.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora/do/repositorio/service-account.json
